ga&lt;br&gt;fatorScore = min(score/1000, 1)&lt;br&gt;fatorFolga = 1 − fatura/(fatura+limite)" style="shape=note;whiteSpace=wrap;html=1;size=12;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="560" y="345" width="270" height="60" as="geometry"/></mxCell><mxCell id="arq-v13" value="&lt;b&gt;DecisaoPersistenceService&lt;/b&gt;&lt;br&gt;@Retry → @CircuitBreaker → @Transactional&lt;br&gt;&lt;i&gt;fallback: só loga erro — a decisão&lt;br&gt;já calculada nunca é perdida&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="470" width="250" height="95" as="geometry"/></mxCell><mxCell id="arq-v14" value="&lt;b&gt;Spring Actuator&lt;/b&gt;&lt;br&gt;/actuator/prometheus" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="650" width="230" height="55" as="geometry"/></mxCell><mxCell id="arq-v15" value="&lt;b&gt;Regras de negócio&lt;/b&gt; — Strategy · @Component&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;descobertas via Spring DI; nova regra = nova classe&lt;/span&gt;" style="swimlane;html=1;startSize=40;rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#f3faf1;" vertex="1" parent="1"><mxGeometry x="880" y="80" width="280" height="400" as="geometry"/></mxCell><mxCell id="arq-v16" value="«interface»&lt;br&gt;&lt;b&gt;RegraCredito&lt;/b&gt;&lt;br&gt;avaliar(Cliente): ResultadoRegra" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="905" y="130" width="230" height="60" as="geometry"/></mxCell><mxCell id="arq-v17" value="&lt;b&gt;RegraScoreMinimo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;score ≥ 600&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#82b